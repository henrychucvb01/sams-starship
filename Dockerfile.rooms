FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci && mkdir /data && chown node:node /data
COPY src/engine ./src/engine
COPY server ./server
USER node
ENV PORT=8787 STARSHIP_HOST=0.0.0.0 STARSHIP_DB=/data/rooms.sqlite
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "server/start.ts"]
